{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agpprotocol.org/schema/agp.signature-statement-3.schema.json",
  "title": "AGP Signature Statement 3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "purpose",
    "context_object_type",
    "context_digest",
    "signer_id",
    "key_id",
    "algorithm",
    "signed_at"
  ],
  "properties": {
    "object_type": {
      "const": "agp.signature-statement/3"
    },
    "purpose": {
      "const": "decision-context-attestation"
    },
    "context_object_type": {
      "const": "agp.decision-context/3"
    },
    "context_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "signer_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/-]{1,126}[a-z0-9]$"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/-]{1,126}[a-z0-9]$"
    },
    "algorithm": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/-]{1,126}[a-z0-9]$"
    },
    "signed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
